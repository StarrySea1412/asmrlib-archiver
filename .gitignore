# deliverable APKs are built, not tracked (they were once two renamed copies
# of the same file, which is how "did you actually repackage?" became hard to
# answer).  The root copy is refreshed from the build output and compared by
# md5 instead.
*.apk


# ===== local ZCode session state + temp probe scripts =====
.zcode/
.zcodeignore
tmp-*.py
